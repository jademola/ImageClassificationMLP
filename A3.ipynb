    "# normalization statistics from the training split only (not validation)\n",
    "# this method based on numpy simplicity in the CS231n data processing reference\n",
    "\n",
    "mean = x_train.mean()\n",
    "std = x_train.std()\n",
    "print(f'train mean: {mean:.3f}, train std: {std:.3f}')\n",
    "\n",
    "# apply the same mean and std to all three sets\n",
    "x_train = (x_train - mean) / std\n",
    "x_val   = (x_val - mean) / std\n",
    "x_test  = (x_test - mean) / std\n",
    "\n",
    "print(f'train: mean {x_train.mean():.3f}, std {x_train.std():.3f}')\n",
    "print(f'val:   mean {x_val.mean():.3f}, std {x_val.std():.3f}')\n",
