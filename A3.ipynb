    "class GradientDescent:\n",
    "\n",
    "    # batch_size: N = full-batch GD, 64 = mini-batch (default), 1 = SGD\n",
    "    def __init__(self, learning_rate, epochs = 10, batch_size = 64):\n",
    "\n",
    "        self.learning_rate = learning_rate\n",
    "        self.epochs = epochs\n",
    "        self.batch_size = batch_size\n",
    "        \n",
    "    def run(self, gradient_fn, x, y, params):\n",
    "\n",
    "        N = x.shape[0] \n",
    "        for epoch in range(self.epochs):\n",
    "            # shuffle the training data every epoch\n",
    "            order = np.random.permutation(N)\n",
    "\n",
    "            # select a batch of `batch_size` samples each time\n",
    "            for i in range(0, N, self.batch_size):\n",
    "                batch = order[i : i+self.batch_size]\n",
    "                grad = gradient_fn(x[batch], y[batch], params)\n",
    "                for p in range(len(params)):\n",
    "                    params[p] -= self.learning_rate * grad[p]\n",
    "\n",
    "\n",
    "            print(f\"Epoch {epoch + 1}/{self.epochs} done\")\n",
    "        return params"
   ]
